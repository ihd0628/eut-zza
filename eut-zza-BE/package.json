{
  "name": "eut-zza-be",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:raw": "tsx watch src/server.ts",
    "dev:fastify": "tsx watch --env-file=.env src/fastify-server.ts",
    "db:check": "tsx --env-file=.env src/db-check.ts",
    "db:migrate": "tsx --env-file=.env src/migrate.ts",
    "db:migrate:prod": "node dist/migrate.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:raw": "node dist/server.js",
    "start:fastify": "node --env-file=.env dist/fastify-server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "oxlint src"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.82.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "redis": "^6.3.0"
  }
}
